{
    "layer": "top",
    "margin-top": 2,
    "margin-bottom": -6,



    // MODULOS DE LA IZQUIERDA
    "modules-left": [
        "custom/launcher",
        //"custom/power",
        "battery",
        "hyprland/workspaces"
    ],
    "custom/power": {
        "format" : "⏻",
		"on-click": "wlogout"
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 20,
            "critical": 10
        },
        "bat": "BAT0",
        "interval": 4,
        "backend": "upower",
        "format": "{icon} {capacity}%",
        "format-icons": ["", "", "", "", ""],

        "format-charging": "{icon} {capacity}% ",
        "format-icons-charging": ["", "", "", "", ""]
    },
    "hyprland/workspaces": {
	    "format": "{name}",
        "persistent-workspaces": {
            "*": 5, // 5 workspaces by default on every monitor
            "HDMI-A-1": 3 // but only three on HDMI-A-1
        }
    },
    // FIN DE MODULOS DE LA IZQUIERDA



    // MODULOS DEL CENTRO
    "modules-center": [
        "clock"
    ],
    "clock": {
        "format-alt": "{:%a, %d. %b  %H:%M}",
        "interval": 60,
        "tooltip": true,
        "format": "{:%H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    // FIN DE MODULOS DEL CENTRO



    // MODULOS DE LA DERECHA
    "modules-right": [
        "network",
        "bluetooth", 
        "backlight", 
        "pulseaudio",
        "custom/notification"
    ],
    "network": {
        "interface": "wlan0",
        "format": "{ifname}",
        "format-wifi": "",
        "format-ethernet": "{ipaddr}/{cidr} 󰊗",
        "format-disconnected": "󰖪", //An empty format will hide the module.
        "tooltip-format": "{ifname} via {gwaddr} 󰊗",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
        "tooltip-format-ethernet": "{ifname} ",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "~/.config/waybar/scripts/wifi_menu.sh",
        "max-length": 50
    },
    "bluetooth": {
	    // "controller": "controller1", // specify the alias of the controller if there are more than 1 on the system
	    "format": " {status}",
	    "format-disabled": " {status}", // an empty format will hide the module
	    "format-connected": " {num_connections}",
	    "tooltip-format": "{controller_alias}\t{controller_address}",
	    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
	    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "wifi-manager --toggle"
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "{icon} {percent}%",
        "format-icons": [""],
        "on-click": "~/.config/waybar/scripts/brightness_slider.sh"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": " {volume}%",
        "format-muted": "",
        "format-icons": {
            "headphone": "",
            "phone": "",
            "phone-muted": "",
            "portable": "",
            "default": ["", ""]
        },
        "scroll-step": 1,
        "on-click": "pavucontrol",
        "ignored-sinks": ["Easy Effects Sink"]
    },
    "custom/notification": {
        "format": "{icon}",
        "format-icons": {
          "notification": "<span foreground='red'><sup></sup></span>",
          "none": "",
          "dnd-notification": "<span foreground='red'><sup></sup></span>",
          "dnd-none": "",
          "inhibited-notification": "<span foreground='red'><sup></sup></span>",
          "inhibited-none": "",
          "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
          "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    // FIN DE MODULOS DE LA DERECHA


    "custom/launcher":{
        "format": "   ",
        "on-click": "rofi -show drun",
        "on-click-right": "killall rofi"
    },

    "cpu": {
        "format": "  {usage}%",
        "tooltip": true
    },
    "memory": {
        "format": "  {}%",
	"tooltip": true
    },
    "temperature": {
        "interval": 10,
        "hwmon-path": "/sys/devices/platform/coretemp.0/hwmon/hwmon4/temp1_input",
        "critical-threshold": 100,
        "format-critical": " {temperatureC}",
        "format": " {temperatureC}°C"
    },

    "mpris": {
        "exec": "playerctl metadata --format '{{ artist }} - {{ title }}'",
	    "format":"1{player_icon} {dynamic}",
	    "format-paused": "{status_icon} <i>{dynamic}</i>",
	    "player-icons": {
		    "default": "▶",
		    "mpv": "🎵"
	    },
	    "status-icons": {
		    "paused": "⏸"
	    },
	    "ignored-players": ["firefox"]
    }
}
